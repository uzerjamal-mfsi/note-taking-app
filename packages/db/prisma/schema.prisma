generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]
  notes             Note[]
  tags              Tag[]
}

model Note {
  id        String    @id @default(uuid())
  userId    String
  title     String
  content   Json
  // Full-document plain-text extraction of `content`, computed and written by
  // `NotesService.createNote`/`updateNote` (see `extractSearchText` in
  // apps/api/src/notes/notes-service.ts) at the same time as `title`. Backs
  // `searchVector` below; never read or written anywhere else.
  searchText String    @default("")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  tags       NoteTag[]
  sharedNote SharedNote?

  // Generated (STORED) tsvector column — `setweight(to_tsvector(title), 'A')
  // || setweight(to_tsvector(searchText), 'B')` — added by migration
  // 20260927120000_add_note_search and backing full-text search (AB-1007).
  // Prisma has no native tsvector type, so this is declared as
  // `Unsupported(...)`; Prisma Client automatically excludes `Unsupported`
  // fields from selection, so NotesRepository never needs to handle it. The
  // GIN index on this column has no Prisma-schema representation at all (an
  // index on an `Unsupported` field can't be declared here) and exists only
  // in that migration's hand-written SQL — there is nothing to approximate,
  // unlike the userId/name indexes documented below.
  searchVector Unsupported("tsvector")?

  // The actual index in the database is a partial index —
  // `CREATE INDEX ... ON "Note"("userId") WHERE "deletedAt" IS NULL` — hand-edited
  // into migration 20260926144918_add_note because Prisma's schema DSL can't express
  // a WHERE-qualified index. This declaration is the closest Prisma-representable
  // approximation, kept so Prisma still knows a userId index exists. Because it does
  // not match the real partial index, `prisma migrate dev` will detect "drift" and
  // interactively offer to generate a fixup migration — do NOT accept that prompt
  // (it would silently replace the partial index with a plain composite one). Cancel
  // it (Ctrl+C) and leave the migration history as-is; `prisma migrate status`/
  // `prisma migrate deploy` are unaffected and report no pending migrations.
  @@index([userId, deletedAt])
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  // Unused in this change (AB-1005) — added ahead of AB-1006's tag-management
  // feature so that ticket doesn't need its own migration for a column with no
  // other dependents. Nothing here reads or writes it.
  color     String   @default("#64748B")
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id])
  notes NoteTag[]

  // The actual constraint in the database is a case-insensitive unique index —
  // `CREATE UNIQUE INDEX ... ON "Tag" (userId, lower(name))` — hand-edited into
  // the migration that introduces this model because Prisma's schema DSL can't
  // express a functional index. This declaration is the closest Prisma-representable
  // approximation, kept so Prisma still knows a uniqueness constraint exists. Because
  // it does not match the real functional index, `prisma migrate dev` will detect
  // "drift" and interactively offer to generate a fixup migration — do NOT accept
  // that prompt (it would silently replace the case-insensitive index with a
  // plain composite one). Cancel it (Ctrl+C) and leave the migration history as-is;
  // `prisma migrate status`/`prisma migrate deploy` are unaffected and report no
  // pending migrations.
  @@unique([userId, name])
}

model NoteTag {
  noteId String
  tagId  String

  note Note @relation(fields: [noteId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model SharedNote {
  id        String    @id @default(uuid())
  noteId    String    @unique
  token     String    @unique
  viewCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  user        User          @relation(fields: [userId], references: [id])
  replacedBy  RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id])
  replacedFor RefreshToken? @relation("RefreshTokenReplacement")

  @@index([familyId])
  @@index([userId])
}
