{
  "name": "note-taking-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @note-taking-app/api --filter @note-taking-app/web run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @note-taking-app/web run test:e2e",
    "db:migrate": "pnpm --filter @note-taking-app/db exec prisma migrate dev --skip-generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@vitest/coverage-v8": "3.0.0",
    "eslint": "9.15.0",
    "husky": "9.1.7",
    "prettier": "3.4.1",
    "typescript": "5.7.2"
  }
}
